# Environment Configuration for UI E2E Tests

# Test Environment (DEV or STAGING) – selects the data/*_Dev.json or *_Staging.json files
TEST_ENVIRONMENT=DEV

# Base URL of the calculator UI (calculator_ui_ts, Vite dev server or preview)
UI_BASE_URL=http://localhost:5173

# Base URL of the calculator API (calculator_api_ts) – used for the health probe and as result oracle
API_BASE_URL=http://localhost:3000

# Debug Settings
DEBUG_API_CALLS=false
